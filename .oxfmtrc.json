{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": ["pnpm-lock.yaml"],
  "overrides": [
    {
      "files": ["README.md", "README.zh-CN.md", "docs/**/*.md"],
      "options": {
        "printWidth": 88,
        "proseWrap": "preserve"
      }
    }
  ]
}
