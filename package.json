{
  "name": "ji",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "demo": "pnpm --filter @ji.dev/demo start",
    "coding-agent": "pnpm --filter @ji.dev/coding-agent start",
    "website": "pnpm --filter @ji.dev/website dev",
    "agent-server": "pnpm --filter @ji.dev/coding-agent serve",
    "desktop": "cd apps/desktop && go run .",
    "desktop:onboarding": "cd apps/desktop && go run . -onboarding",
    "desktop:bundle-agent": "rolldown apps/coding-agent/src/server.ts --platform node --format esm --cleanDir --dir apps/desktop/resources/agent-server",
    "desktop:build": "pnpm desktop:bundle-agent && cd apps/desktop && go tool mygo build",
    "replay": "node apps/replay/src/cli.ts",
    "replay:shell": "node apps/replay/src/cli.ts shell",
    "release": "node apps/release/src/cli.ts",
    "build": "pnpm --filter \"./packages/*\" --filter \"./plugins/*\" --filter @ji.dev/coding-agent run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm lint:go",
    "lint:go": "cd apps/desktop && go tool -modfile=golangci-lint.mod golangci-lint run && go tool mygo vet",
    "lint:fix": "eslint . --fix",
    "lint:eval": "cd eval && uv run ruff check && uv run ruff format --check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-slop": "^0.1.3",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "oxfmt": "^0.70.0",
    "rolldown": "^1.2.9",
    "tsdown": "^0.23.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
