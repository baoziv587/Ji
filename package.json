{
  "name": "ji",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "pnpm --filter @ji.dev/demo start",
    "coding-agent": "pnpm --filter @ji.dev/coding-agent start",
    "replay": "node apps/replay/src/cli.ts",
    "replay:shell": "node apps/replay/src/cli.ts shell",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:eval": "cd eval && uv run ruff check && uv run ruff format --check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-slop": "^0.1.3",
    "fast-check": "^4.10.2",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
