{
  "name": "@ji.dev/tui",
  "type": "module",
  "version": "0.0.0",
  "description": "Terminal UI pieces for a full-screen chat: the screen and its bars, streaming Markdown, code and diffs in color, an input line, text cut by display width",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baoziv587/Ji.git",
    "directory": "packages/tui"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown -c ../../tsdown.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "fast-string-truncated-width": "^3.0.3",
    "fast-wrap-ansi": "^0.2.2",
    "marked": "^18.0.14",
    "shiki": "^4.5.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
